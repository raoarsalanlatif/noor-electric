# Copy to .env for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# MongoDB Atlas connection string
DB_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/
# Database name inside the cluster (optional, default: noor_electric)
DB_NAME=noor_electric

# Long random string used to sign admin sessions (at least 24 characters)
JWT_SECRET=

# First owner account — used only for the very first sign-in, when no users exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
